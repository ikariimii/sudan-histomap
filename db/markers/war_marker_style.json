 "span_state_rule": "ongoing if war.ongoing===true; else closed if war.end!=null; else end_unknown. Never infer ongoing from note text.",
 "states": {
  "closed": {
   "bar": "solid, start->end, fill colour @0.55, 6px tall, 1px #0f1b24 edge, end caps = icon at start, 2px tick at end"
  },
  "ongoing": {
   "bar": "start->present edge (2026), fill colour gradient @0.55->@0.15 over last 15% of track, chevron arrow at right edge (left in RTL)",
   "label_suffix_en": "– present",
   "label_suffix_ar": "– حتى الآن [يحتاج تحقق]"
  },
  "end_unknown": {
   "bar": "NONE. Draw start marker (icon disc) + 12px dashed stub (dash 2 2, colour @0.7) ending in a small open circle; tooltip 'end not recorded'",
   "label_suffix_en": "– end not recorded",
   "label_suffix_ar": "– نهاية غير مسجلة [يحتاج تحقق]",
   "rule": "never imply a span or the present"
  },
  "single_year": {
   "when": "start==end",
   "mark": "icon disc only, no bar"
  }
 },
 "battle_point": {
  "base": "existing battle_*.svg precision variants (battle_style.json)",
  "war_tint": "exact: disc fill = war colour; approximate: ring = war colour; region: halo = war colour; reported: unchanged grey #b9a8a2",
  "badge": "war icon 10px at top-right of marker at zoom>=8",
  "no_war_id": "#f08c6c default"
 },
 "hover": {
  "scale": 1.15,
  "outline": "#ffd54a 2",
  "span": "bar opacity ->0.9, other wars ->0.25",
  "sync": "hovering bar highlights its battles on map and vice versa"
 },
