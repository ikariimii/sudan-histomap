{
 "meta": {
  "built": "2026-10-20",
  "owner": "Sudan Geopolitical Analyst",
  "status": "METHOD APPROVED by Innovation Manager 2026-10-24 for modern eras only (CINC 1816–2016); staging file, not merged into data/eras",
  "schema": "Two separate fields, never mixed or rescaled: `power_cinc_share` = computed CINC regional share {actor, share (0–1 or null), year_range [from,to] actually scored, basis, method, source_ids, flag, null_reason}, cited to COW_NMC6 with the year range, valid 1816–2016 only; `power_editorial` = existing hand-assigned ordinals (Kush, Mahdist) badged EDITORIAL, copied unchanged from data/eras. No new hand scores before 1816.",
  "method": {
   "id": "RP-CINC-SHARE-1",
   "formula": "score = mean over era years y in [max(start,1816), min(end,2016)] with data of CINC_actor(y) / Σ_{c in set} CINC_c(y); rounded to 2 dp",
   "regional_set": "Sudan 625, South Sudan 626, Egypt 651, Ethiopia 530, Eritrea 531, Chad 483, Libya 620, CAR 482 (states in data that year)",
   "null_rule": "null when no CINC year overlaps the era (pre-statehood, pre-1816 or post-2016). Not extrapolated; WDI given as context only",
   "wdi_role": "context indicators only (population, GDP current US$, armed forces personnel, military expenditure current US$, surface area); not in the score"
  },
  "sources": {
   "COW_NMC6": {
    "author": "Singer, Bremer & Stuckey (1972); Greig & Enterline (v6.0)",
    "title": "Correlates of War National Material Capabilities v6.0 (abridged CSV)",
    "title_en": "same",
    "publisher": "Correlates of War Project",
    "bias": "academic; Cold-War realist index (pop, urban pop, iron/steel, energy, mil personnel, mil spending); weak for low-industry states",
    "date": "2021 (data 1816–2016)",
    "url": "https://correlatesofwar.org/data-sets/national-material-capabilities/",
    "license": "No licence statement found: the COW NMC page (correlatesofwar.org, read 2026-10-24) and the v6.0 codebook PDF (read 2026-10-24) give no licence or terms; the page asks users 'to give the version number and cite an article of record' (Singer, Bremer & Stuckey 1972). Reuse rights beyond citation are not stated.",
    "verification": "downloaded NMC_Documentation-6.0.zip 2026-10-20, NMC-60-abridged.csv read; licence/terms check 2026-10-24: COW NMC page + NMC_Documentation_v6_0 PDF read. Note: the page now offers v7.0 (1816–2022); this proposal uses v6.0 as approved."
   },
   "WB_WDI_API": {
    "author": "World Bank",
    "title": "World Development Indicators (API v2): SP.POP.TOTL, NY.GDP.MKTP.CD, MS.MIL.TOTL.P1 (IISS), MS.MIL.XPND.CD (SIPRI), AG.SRF.TOTL.K2",
    "title_en": "same",
    "publisher": "World Bank",
    "bias": "IFI; Sudan series exclude South Sudan in all years; military series reproduce IISS/SIPRI estimates",
    "date": "lastupdated 2026-10-08",
    "url": "https://api.worldbank.org/v2/country/SDN;EGY;ETH;ERI;TCD;LBY;CAF;SSD/indicator/SP.POP.TOTL",
    "license": "CC BY 4.0",
    "verification": "API queried 2026-10-20"
   }
  },
  "rulings_2026-10-24": [
   "power_cinc_share only for years 1816–2016",
   "power_editorial kept separate, badged EDITORIAL, no rescaling/mixing",
   "no new pre-1816 hand scores",
   "2019 and 2023 eras: null, reason 'data ends 2016'"
  ]
 },
