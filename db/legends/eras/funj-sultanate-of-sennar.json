 "context": {
  "key_events_en": [
   "King 'Umara Dunqas defeats the 'Abdallabi at Arbaji, 1504 (GHA V ch.7 p.173)",
   "Islamisation; Sufi orders introduced from the Hijaz, the Qadiriyya in 1577 (GHA V ch.7 pp.173, 179–180)",
   "Turco-Egyptian forces take Sennar, 1821 (GHA V ch.7 p.185)",
   "Holt & Daly: Funj suzerainty over Upper Nubia (above 3rd Cataract) incl. vassal-kingdom of Dongola; 'Abdallab recognised as paramount chiefs of the Arabs"
  ],
  "key_events_ar": [
   "أسسها عمارة دنقس 1504 [يحتاج تحقق]",
   "انتشار الإسلام والطرق الصوفية [يحتاج تحقق]",
   "فتحها الجيش التركي المصري 1821 [يحتاج تحقق]",
   "هولت وديلي: سيادة الفونج على النوبة العليا (جنوب الشلال الثالث) بما فيها مملكة دنقلا التابعة؛ والاعتراف بالعبدلاب شيوخاً أعلى للعرب"
  ],
  "key_events_source_ids": [
   "HD2011",
   "SPAULDING1985",
   "GHA5_CH7",
   "GHA6_CH14"
  ],
  "dating_note": "1504–1821: Funj victory over the 'Abdallabi at Arbaji in 1504 (GHA V ch.7 p.173); Turco-Egyptian forces take Sennar in 1821 (GHA V ch.7 p.185; GHA VI ch.14 p.356: the Sennar rulers 'capitulated to the Turkish rulers in 1821' after the sultanate's disintegration into 'weak and hostile shaykhdoms'). Foundation by a Shilluk band is a tradition, not established fact [NO-SOURCE: no page read].",
  "capitals": [
   {
    "name": "Sennar",
    "lat": 13.55,
    "lon": 33.62
   }
  ],
  "control_limits_en": "'Upper Nubia, above the Third Cataract, was under the suzerainty of the Funj rulers', while Lower Nubia (First to Third Cataract) was 'nominally at least' dependent on Ottoman Egypt (HD2011). 'Kordofan was a debatable land between the rulers of Sennar and Darfur' (HD2011). By 1523 the Funj sultanate reached north to Dongola, and after 1585 Hannik, south of the Third Cataract, became the Funj–Ottoman border (ZH_EMB_HIST2020).",
  "control_limits_ar": "«كانت النوبة العليا، فوق الشلال الثالث، تحت سيادة حكام الفونج»، بينما كانت النوبة السفلى (من الشلال الأول إلى الثالث) تابعة «اسمياً على الأقل» لمصر العثمانية (هولت وديلي). و«كانت كردفان أرضاً متنازعاً عليها بين حكام سنار ودارفور». وبحلول 1523 امتدت سلطنة الفونج شمالاً حتى دنقلا، وبعد 1585 صارت حنّيك جنوب الشلال الثالث حدّاً بين الفونج والعثمانيين (نص السفارة الصينية).",
  "control_limits_source_ids": [
   "HD2011",
   "ZH_EMB_HIST2020"
  ],
  "control_confidence": "medium"
 },
